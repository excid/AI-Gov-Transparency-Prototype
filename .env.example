# External data source (required for data collection commands)
GOVSPENDING_API_KEY=replace_with_govspending_api_key

# OpenAI-compatible LLM endpoint (required for LLM-assisted TOR extraction)
LLM_API_KEY=replace_with_llm_api_key
LLM_BASE_URL=https://your-llm-provider.example/v1
LLM_MODEL=qwen3.8-flash

# Local frontend/backend connection
NEXT_PUBLIC_ANALYSIS_URL=http://127.0.0.1:8000/analyze-tor
ML_SERVICE_URL=http://127.0.0.1:8000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Model and worker settings
TOR_MODEL_PATH=data/models/tor-isolation-forest.joblib
MAX_CONCURRENT_ANALYSES=1

# PaddleOCR tuning
OCR_DEVICE=auto
OCR_RENDER_DPI=240
OCR_CONTRAST=1.25
OCR_MIN_CONFIDENCE=0.72
OCR_CACHE_ENTRIES=8

# Tesseract fallback settings (optional)
OCR_DPI=150
OCR_PSM=6
TESSERACT_CMD=
